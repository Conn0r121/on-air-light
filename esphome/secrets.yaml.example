# Copy this file to secrets.yaml (in the same directory as on-air-light.yaml —
# in the ESPHome dashboard that's the config directory, where you can edit it
# via the "Secrets" menu in the top-right). Fill in real values.
# secrets.yaml is gitignored; never commit it.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# 32 random bytes, base64-encoded. Generate with one of:
#   on the Pi:  openssl rand -base64 32
#   PowerShell: [Convert]::ToBase64String([byte[]](1..32 | ForEach-Object { Get-Random -Maximum 256 }))
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"

# Any strong password; authenticates over-the-air firmware updates.
ota_password: "REPLACE_WITH_OTA_PASSWORD"

# Password for the fallback hotspot the device opens if it can't reach WiFi.
fallback_ap_password: "REPLACE_WITH_AP_PASSWORD"
